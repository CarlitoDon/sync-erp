{
  "buildCommand": "unset TURBO_REMOTE_ONLY && npx turbo run build --filter=@sync-erp/web",
  "outputDirectory": "apps/web/dist",
  "installCommand": "npm install",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://api-sync-erp.khusnudhoni.online/api/:path*"
    },
    {
      "source": "/health",
      "destination": "https://api-sync-erp.khusnudhoni.online/health"
    },
    {
      "source": "/readyz",
      "destination": "https://api-sync-erp.khusnudhoni.online/readyz"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
