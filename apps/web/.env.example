# Example Environment for Web
# Copy this file to .env, .env.staging, or .env.production

# sync-erp API (must use VITE_ prefix for client-side access)
VITE_SYNC_ERP_API_URL=http://localhost:3001/api/trpc

# Google AdSense for free-plan app pages
VITE_GOOGLE_ADSENSE_ENABLED=false
VITE_GOOGLE_ADSENSE_CLIENT_ID=
VITE_GOOGLE_ADSENSE_DEFAULT_SLOT=
VITE_GOOGLE_ADSENSE_FOOTER_SLOT=

# Optional Sentry/Error Tracking
# Leave the DSN empty for local/no-domain MVP. Add a real DSN only after a
# Sentry project exists; never commit a real DSN or auth token.
VITE_SENTRY_DSN=
VITE_SENTRY_ENABLED=false
VITE_SENTRY_ENVIRONMENT=development
VITE_SENTRY_TRACES_SAMPLE_RATE=0.05
VITE_SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE=0.1
