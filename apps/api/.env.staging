# Staging Environment for API
NODE_ENV=staging

# Database
DATABASE_URL="postgresql://user:password@host:5432/sync_erp_staging"

# ========================================
# Authentication Secrets
# ========================================

# Auth for API (services calling this API)
SYNC_ERP_API_SECRET=dev_sync_erp_secret_key_2026

# ========================================
# Service URLs
# ========================================

# Public API URL (self reference for tRPC)
SYNC_ERP_API_URL=https://api-staging.sync-erp.com/api/trpc

# Public web URL used to build email verification links
SYNC_ERP_WEB_URL=https://staging.sync-erp.com

# Optional explicit API base URL for non-tRPC routes such as billing checkout pages
SYNC_ERP_API_BASE_URL=https://api-staging.sync-erp.com

# ========================================
# CORS
# ========================================
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://staging.sync-erp.com,https://sync-erp-git-dev-doncarlo31s-projects.vercel.app

# ========================================
# Integration webhooks
# ========================================
BILLING_WEBHOOK_SECRET=replace_with_staging_webhook_secret
SECURE_COOKIES=true

# Optional Bot Connector
SYNC_ERP_BOT_URL=
SYNC_ERP_BOT_SECRET=dev_bot_secret_key_2026
