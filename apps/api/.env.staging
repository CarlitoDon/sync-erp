# Staging Environment for API
NODE_ENV=staging

# Database
DATABASE_URL="postgresql://user:password@host:5432/sync_erp_staging"

# ========================================
# Authentication Secrets
# ========================================

# Auth for API (services calling this API)
SYNC_ERP_API_SECRET=dev_sync_erp_secret_key_2026

# Secret used to sign Google OAuth state values
SYNC_ERP_AUTH_STATE_SECRET=replace_with_staging_oauth_state_secret

# Google OAuth credentials
GOOGLE_OAUTH_CLIENT_ID=replace_with_google_oauth_client_id
GOOGLE_OAUTH_CLIENT_SECRET=replace_with_google_oauth_client_secret
GOOGLE_OAUTH_REDIRECT_URI=https://api-staging.santiliving.com/api/auth/google/callback

# ========================================
# Service URLs
# ========================================

# Public API URL (self reference for tRPC)
SYNC_ERP_API_URL=https://api-staging.santiliving.com/api/trpc

# Public web URL used to build email verification links
SYNC_ERP_WEB_URL=https://sync-erp-staging.santiliving.com

# Optional explicit API base URL for non-tRPC routes such as billing checkout pages
SYNC_ERP_API_BASE_URL=https://api-staging.santiliving.com

# ========================================
# CORS
# ========================================
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://sync-erp-staging.santiliving.com,https://sync-erp-git-dev-doncarlo31s-projects.vercel.app
CORS_ORIGIN=http://localhost:5173,https://sync-erp-staging.santiliving.com,https://sync-erp-git-dev-doncarlo31s-projects.vercel.app

# ========================================
# Integration webhooks
# ========================================
BILLING_WEBHOOK_SECRET=replace_with_staging_webhook_secret
SECURE_COOKIES=true

# Optional Bot Connector
SYNC_ERP_BOT_URL=
SYNC_ERP_BOT_SECRET=dev_bot_secret_key_2026
