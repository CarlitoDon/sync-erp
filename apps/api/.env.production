# Production Environment for API
NODE_ENV=production

# Database
DATABASE_URL="postgresql://user:password@host:5432/sync_erp"

# ========================================
# Authentication Secrets
# ========================================

# Auth for API (services calling this API)
SYNC_ERP_API_SECRET=replace_with_production_api_secret

# ========================================
# Service URLs
# ========================================

# Public API URL (self reference for tRPC)
SYNC_ERP_API_URL=https://api.sync-erp.com/api/trpc

# Public web URL used to build email verification links
SYNC_ERP_WEB_URL=https://app.sync-erp.com

# Optional explicit API base URL for non-tRPC routes such as billing checkout pages
SYNC_ERP_API_BASE_URL=https://api.sync-erp.com

# ========================================
# CORS
# ========================================
CORS_ALLOWED_ORIGINS=https://app.sync-erp.com,https://sync-erp.vercel.app

# ========================================
# Integration webhooks
# ========================================
BILLING_WEBHOOK_SECRET=replace_with_production_webhook_secret
SECURE_COOKIES=true

# Optional Bot Connector
SYNC_ERP_BOT_URL=
SYNC_ERP_BOT_SECRET=replace_with_production_bot_secret
