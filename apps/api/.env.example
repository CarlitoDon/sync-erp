# Example Environment for API
# Copy this file to .env, .env.staging, or .env.production
NODE_ENV=development

# Database
DATABASE_URL="postgresql://user:password@host:port/database"

# ========================================
# Authentication Secrets
# ========================================

# Auth for API (services calling this API)
SYNC_ERP_API_SECRET=your_sync_erp_api_secret

# ========================================
# Service URLs
# ========================================

# Public API URL (self reference for tRPC)
SYNC_ERP_API_URL=http://localhost:3001/api/trpc

# Public web URL used to build email verification links
SYNC_ERP_WEB_URL=http://localhost:5173

# Optional explicit API base URL for non-tRPC routes such as billing checkout pages
SYNC_ERP_API_BASE_URL=http://localhost:3001

# Secret used to sign OAuth state values
SYNC_ERP_AUTH_STATE_SECRET=replace_with_a_long_random_secret

# Google OAuth credentials
GOOGLE_OAUTH_CLIENT_ID=your_google_client_id
GOOGLE_OAUTH_CLIENT_SECRET=your_google_client_secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# MCP SSE access control and internal upstream auth
SYNC_ERP_MCP_BEARER_TOKEN=replace_with_a_long_random_token
SYNC_ERP_MCP_MAX_SESSIONS=50
SYNC_ERP_MCP_SESSION_TTL_MS=900000
SYNC_ERP_MCP_API_URL=http://localhost:3001/api/trpc
SYNC_ERP_MCP_EMAIL=admin@sync-erp.local
SYNC_ERP_MCP_PASSWORD=password

# Email delivery provider: log | resend
SYNC_ERP_EMAIL_PROVIDER=log

# From address for transactional emails
SYNC_ERP_EMAIL_FROM="Sync ERP <noreply@example.com>"

# Required when SYNC_ERP_EMAIL_PROVIDER=resend
RESEND_API_KEY=re_xxxxxxxxx

# ========================================
# CORS
# ========================================
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://your-domain.com

# ========================================
# Integration webhooks
# ========================================
# Tenant webhook endpoints are configured per integration/API key in the app.
BILLING_WEBHOOK_SECRET=replace_with_a_long_random_webhook_secret

# ========================================
# Billing Provider
# ========================================
BILLING_PROVIDER=MIDTRANS
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_SERVER_KEY=your_midtrans_server_key
MIDTRANS_CLIENT_KEY=your_midtrans_client_key
