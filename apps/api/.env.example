# Local/staging sandbox: keep MIDTRANS_IS_PRODUCTION=false and use SB-Mid-* keys.
# Production deploy: set MIDTRANS_IS_PRODUCTION=true and use live Mid-* keys from
# the merchant Midtrans dashboard. Never mix live keys with sandbox mode, and
# never commit real keys to git.
BILLING_PROVIDER=MIDTRANS
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_SERVER_KEY=SB-Mid-server-your_sandbox_key
MIDTRANS_CLIENT_KEY=SB-Mid-client-your_sandbox_key

# ========================================
# Optional Sentry/Error Tracking
# ========================================
# Leave unset for local/no-domain MVP. Set a real project DSN only after creating
# the Sentry project; never commit a real DSN or auth token to the repository.
SENTRY_DSN=
SENTRY_ENABLED=false
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.05
SENTRY_PROFILES_SAMPLE_RATE=0

# Disabled by default. In production this route also requires
# SENTRY_ALLOW_PRODUCTION_TEST_ROUTE=true.
SENTRY_TEST_ROUTE_ENABLED=false
SENTRY_ALLOW_PRODUCTION_TEST_ROUTE=false
