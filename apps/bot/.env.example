# Example Environment for Bot
# Copy this file to .env, .env.staging, or .env.production
NODE_ENV=development
PORT=3010

# ========================================
# Authentication
# ========================================

# Auth for Bot service (callers authenticate with this)
SYNC_ERP_BOT_SECRET=your_sync_erp_bot_secret

# ========================================
# Service Connections
# ========================================

# sync-erp API
SYNC_ERP_API_URL=http://localhost:3001/api/trpc
SYNC_ERP_API_SECRET=your_sync_erp_api_secret

# Redis
REDIS_URL=redis://localhost:6379
# Prefix for Redis keys (isolates prod/staging on shared Redis)
REDIS_KEY_PREFIX=baileys:auth:

# ========================================
# Inbound Customer Message Webhook
# ========================================
# Priority: CARLA_WEBHOOK_URL || RARA_WEBHOOK_URL || BOT_WEBHOOK_URL
CARLA_WEBHOOK_URL=http://host.docker.internal:8645/webhooks/whatsapp-inbound
RARA_WEBHOOK_URL=http://127.0.0.1:8644/p/rara/webhooks/whatsapp-inbound

# ========================================
# Bot Behavior Controls
# ========================================

# Whitelist control:
# true  = only numbers in ALLOWED_CUSTOMER_PHONES or Redis whatsapp:allowed_phones can chat.
# false = open mode, all customers can chat with the bot.
BOT_WHITELIST_ENABLED=true

# Allowed customer phones (comma-separated, auto-seeded into Redis on startup):
ALLOWED_CUSTOMER_PHONES=08123456789,08987654321

# Tester numbers (comma-separated):
# Numbers here bypass both staff protection and whitelist checks.
# Use this so owner/staff (e.g. 085158858310) can test chatting with the bot as a customer.
BOT_TEST_NUMBERS=085158858310

# Staff protection:
# true  = ignore inbound messages from INTERNAL_STAFF_PHONES (prevents feedback loops).
# false = do not ignore staff numbers.
STAFF_PROTECTION_ENABLED=true

# Auto takeover:
# true  = manual reply from scanned phone switches session to HUMAN (AI muted for 30m).
# false = disable auto takeover.
AUTO_TAKEOVER_ENABLED=true

# Debounce window in milliseconds before dispatching messages:
WHATSAPP_DEBOUNCE_MS=7000
