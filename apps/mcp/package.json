{
  "name": "@sync-erp/mcp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "dev:stdio": "tsx src/stdio.ts",
    "e2e:http": "tsx src/e2e.ts",
    "e2e:sse": "npm run e2e:http",
    "smoke:http": "tsx src/smoke.ts",
    "smoke:sse": "npm run smoke:http",
    "start": "node dist/index.js",
    "start:stdio": "node dist/stdio.js",
    "build": "tsup src/index.ts src/stdio.ts --format esm --clean --dts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.0",
    "@types/express": "^4.17.25",
    "express": "^4.22.1",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "tsup": "^8.5.1",
    "tsx": "^4.7.0",
    "typescript": "^5.9.3"
  }
}
